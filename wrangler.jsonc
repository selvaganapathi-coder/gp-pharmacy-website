{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gp-pharmacy-website",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gp-pharmacy-cms",
      "database_id": "3f8f1b99-32d9-4f51-8666-bfd021eff5d0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "gp-pharmacy-uploads"
    }
  ]
}
